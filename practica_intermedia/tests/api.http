### 1) REGISTRO
### Registrar usuario nuevo
POST {{baseUrl}}/user/register
Content-Type: application/json

{
  "email": "victor2@bildyapp.com",
  "password": "password123"
}

### 2) VALIDACIÓN DEL EMAIL
### Validar email con código de 6 dígitos
PUT {{baseUrl}}/user/validation
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "code": "699725"
}

### 3) LOGIN

### Login con credenciales
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "victor2@bildyapp.com",
  "password": "password123"
}

### 4) ONBOARDING — DATOS PERSONALES
### Actualizar datos personales
PUT {{baseUrl}}/user/register
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Víctor",
  "lastName": "Galán Santibáñez",
  "nif": "12345678A",
  "address": {
    "street": "Calle Mayor",
    "number": "42",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### ONBOARDING — COMPAÑÍA 
### Crear/unirse a compañía
PATCH {{baseUrl}}/user/company
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "isFreelance": false,
  "name": "Mi Empresa S.L.",
  "cif": "B12345678",
  "address": {
    "street": "Paseo de la Castellana",
    "number": "100",
    "postal": "28046",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### ONBOARDING — AUTÓNOMO
### Crear compañía como autónomo (usa NIF y datos personales)
PATCH {{baseUrl}}/user/company
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "isFreelance": true
}

### 5) LOGO DE LA COMPAÑÍA
PATCH {{baseUrl}}/user/logo
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< ./logo.png
------FormBoundary--

### 6) OBTENER USUARIO
### Obtener perfil completo
GET {{baseUrl}}/user
Authorization: Bearer {{accessToken}}

### 7) GESTIÓN DE SESIÓN
### Renovar access token con refresh token
POST {{baseUrl}}/user/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### Cerrar sesión
POST {{baseUrl}}/user/logout
Authorization: Bearer {{accessToken}}

### 8) ELIMINAR USUARIO
### Soft delete (desactiva el usuario)
DELETE {{baseUrl}}/user?soft=true
Authorization: Bearer {{accessToken}}

### Hard delete (elimina definitivamente)
DELETE {{baseUrl}}/user?soft=false
Authorization: Bearer {{accessToken}}

### 9) CAMBIAR CONTRASEÑA
### Cambiar contraseña
PUT {{baseUrl}}/user/password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "password123",
  "newPassword": "nuevaPassword456"
}

### Error: las contraseña antigua y nueva son iguales
PUT {{baseUrl}}/user/password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "password123",
  "newPassword": "password123"
}

### 10) INVITAR COMPAÑERO si eres admin
### Invitar usuario a la compañía
POST {{baseUrl}}/user/invite
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "email": "companero3@test.com",
  "name": "Ana",
  "lastName": "Martínez"
}

### CREAR CLIENTE
POST {{baseUrl}}/client
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Empresa Cliente S.L.",
  "cif": "B12345678",
  "email": "cliente@empresa.com",
  "phone": "600123456",
  "address": {
    "street": "Calle Gran Vía",
    "number": "28",
    "postal": "28013",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### LISTAR CLIENTES
GET {{baseUrl}}/client
Authorization: Bearer {{accessToken}}

###

### LISTAR CON FILTRO
GET {{baseUrl}}/client?page=1&limit=5&name=Empresa
Authorization: Bearer {{accessToken}}

###

### OBTENER CLIENTE POR ID
GET {{baseUrl}}/client/69f8f5d04cbb5d438b57f2da
Authorization: Bearer {{accessToken}}

###

### ACTUALIZAR CLIENTE
PUT {{baseUrl}}/client/69f8f5d04cbb5d438b57f2da
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Empresa Cliente Actualizada S.L.",
  "cif": "B12345678",
  "phone": "600999888"
}

###

### ARCHIVAR CLIENTE (soft delete)
DELETE {{baseUrl}}/client/69f8f5d04cbb5d438b57f2da
Authorization: Bearer {{accessToken}}

###

### VER CLIENTES ARCHIVADOS
GET {{baseUrl}}/client/archived
Authorization: Bearer {{accessToken}}

###

### RESTAURAR CLIENTE
PATCH {{baseUrl}}/client/69f8f5d04cbb5d438b57f2da/restore
Authorization: Bearer {{accessToken}}


### CREAR PROYECTO
POST {{baseUrl}}/project
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Proyecto Web Corporativa",
  "projectCode": "PROJ-001",
  "client": "69f8f5d04cbb5d438b57f2da",
  "email": "proyecto@empresa.com",
  "address": {
    "street": "Calle Gran Vía",
    "number": "28",
    "postal": "28013",
    "city": "Madrid",
    "province": "Madrid"
  },
  "notes": "Proyecto de desarrollo web"
}

###

### LISTAR PROYECTOS
GET {{baseUrl}}/project
Authorization: Bearer {{accessToken}}

###

### OBTENER PROYECTO POR ID (cambia el ID)
GET {{baseUrl}}/project/69f8f7cbbefd46a86749a56a
Authorization: Bearer {{accessToken}}

###

### ACTUALIZAR PROYECTO (cambia el ID)
PUT {{baseUrl}}/project/69f8f7cbbefd46a86749a56a
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Proyecto Web Corporativa Actualizado",
  "projectCode": "PROJ-001",
  "client": "69f8f5d04cbb5d438b57f2da"
}

###
### ARCHIVAR PROYECTO
DELETE {{baseUrl}}/project/69f8f7cbbefd46a86749a56a
Authorization: Bearer {{accessToken}}
###

### VER PROYECTOS ARCHIVADOS
GET {{baseUrl}}/project/archived
Authorization: Bearer {{accessToken}}

###

### RESTAURAR PROYECTO (cambia el ID)
PATCH {{baseUrl}}/project/69f8f7cbbefd46a86749a56a/restore
Authorization: Bearer {{accessToken}}


### CREAR ALBARÁN DE HORAS
POST {{baseUrl}}/deliverynote
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "format": "hours",
  "client": "69f8f5d04cbb5d438b57f2da",
  "project": "69f8f7cbbefd46a86749a56a",
  "description": "Trabajo de desarrollo",
  "workDate": "2026-05-04",
  "hours": 8,
  "workers": [
    { "name": "Víctor", "hours": 8 }
  ]
}

###

### CREAR ALBARÁN DE MATERIAL
POST {{baseUrl}}/deliverynote
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "format": "material",
  "client": "69f8f5d04cbb5d438b57f2da",
  "project": "69f8f7cbbefd46a86749a56a",
  "description": "Suministro de materiales",
  "workDate": "2026-05-04",
  "material": "Cemento Portland",
  "quantity": 50,
  "unit": "sacos"
}

###

### LISTAR ALBARANES
GET {{baseUrl}}/deliverynote
Authorization: Bearer {{accessToken}}

###

### OBTENER ALBARÁN POR ID (cambia el ID)
GET {{baseUrl}}/deliverynote/69f9bcd3571ce411224ecf4e
Authorization: Bearer {{accessToken}}

###

### ACTUALIZAR ALBARÁN (cambia el ID)
PUT {{baseUrl}}/deliverynote/69f9bcd3571ce411224ecf4e
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "description": "Descripción actualizada",
  "hours": 10
}

###

### ELIMINAR ALBARÁN (cambia el ID)
DELETE {{baseUrl}}/deliverynote/69f9bcd3571ce411224ecf4e
Authorization: Bearer {{accessToken}}




### FIRMAR ALBARÁN
PATCH {{baseUrl}}/deliverynote/69f9beab6520129373cf402e/sign
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="signature"; filename="firma.png"
Content-Type: image/png

< ./firma.png
------FormBoundary--
